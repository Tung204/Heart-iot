# Sao chép sang .env rồi chỉnh. Không commit .env.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Để trống DATABASE_URL => dùng PGlite (PostgreSQL WASM) tại .data/pglite.
# DATABASE_URL=postgres://annhien:annhien@localhost:5432/annhien
PGLITE_DATA_DIR=.data/pglite
PGLITE_MEMORY=false

# Dung sai đồng hồ thiết bị (giây), 0..3600. Mẫu có measured_at vượt quá
# hiện tại + ngưỡng này bị lưu cách ly (is_quarantined) và không vào đường đọc.
MAX_CLOCK_SKEW_SECONDS=120

# MQTT tùy chọn. Để trống => không kết nối broker.
# MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# AI tùy chọn. Để trống => tóm tắt theo mẫu, không gọi mạng.
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_MS=20000

SESSION_TTL_HOURS=168
